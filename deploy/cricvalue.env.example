# Copy to /etc/cricvalue.env (chmod 640). Never commit this file.
DJANGO_SETTINGS_MODULE=cricvalue.settings_prod
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_HTTPS=0
DB_NAME=cricvalue
DB_USER=cricvalue
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
